PORT=3000
NODE_ENV=production
SESSION_SECRET=troque-por-um-segredo-longo-e-unico
AUTH_USERS_JSON=[{"email":"admin@empresa.com","password":"troque-esta-senha","name":"Administrador","role":"admin"},{"username":"designer","password":"troque-esta-senha","name":"Equipe de Design","role":"admin"}]
GOALFY_BOARD_URL=https://api.goalfy.com.br/...
GOALFY_CLIENTS_URL=https://api.goalfy.com.br/...
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.5-flash-lite

# Banco MySQL gerenciado (ex: Hostinger -> Bancos de dados) usado para
# persistir decisoes de clientes (aprovacao/ajuste em posts). Precisa ser
# externo ao filesystem do app: o deploy refaz o checkout do zero a cada
# publicacao, e um SQLite local se perderia.
# Na Hostinger, com o app rodando como Node.js App na MESMA conta do banco,
# "localhost" funciona e evita o overhead/limite de conexao do hostname
# remoto (ex: srv1234.hstgr.io, usado em MySQL Remoto) -- confirmado em
# 2026-08-14 apos o hostname remoto estourar max_connections_per_hour.
DB_HOST=localhost
DB_PORT=3306
DB_USER=troque-pelo-usuario-do-banco
DB_PASSWORD=troque-pela-senha-do-banco
DB_NAME=troque-pelo-nome-do-banco

# Supabase Storage -- guarda as variantes otimizadas (thumb/preview) de
# imagens dos posts, geradas a partir do arquivo original do Drive. A
# service role / secret key tem acesso privilegiado e nunca deve ser
# exposta ao frontend.
SUPABASE_URL=https://troque-pelo-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=troque-pela-secret-key
SUPABASE_MEDIA_BUCKET=media-variants
